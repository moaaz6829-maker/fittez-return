# ==============================================
# SHOPIFY
# ==============================================
# This app is installed as a Custom App via Shopify Admin > Settings >
# Apps and sales channels > Develop apps -- NOT a public/OAuth-distributed
# app. That screen gives you all three values below directly, with no
# install/OAuth redirect flow involved.
#
# SHOPIFY_API_KEY / SHOPIFY_API_SECRET: used ONLY to verify the App
# Bridge ID token on requests to /api/admin/* (see
# src/middleware/shopifyAuth.ts). They are NOT used for OAuth.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_SCOPES=read_orders,read_products,read_inventory,write_inventory,read_fulfillments
SHOPIFY_APP_URL=https://your-app-url.example.com
SHOPIFY_SHOP=fittez.myshopify.com

# The static Admin API access token issued by the Custom App screen.
# Seeded once into the Store row by prisma/seed.ts -- there is no OAuth
# refresh/rotation flow for this token; if it's ever revoked, generate a
# new one from the same Shopify Admin screen and re-run the seed (or
# update the Store row directly).
SHOPIFY_ADMIN_ACCESS_TOKEN=

# ==============================================
# DATABASE
# ==============================================
DATABASE_URL=postgresql://user:password@localhost:5432/fittez_refund_exchange

# ==============================================
# BOSTA
# ==============================================
BOSTA_API_KEY=
BOSTA_API_BASE_URL=https://app.bosta.co/api/v2
# Shared-secret VALUE for the custom webhook header (see Settings >
# bostaWebhookHeaderName for the header NAME). This is a static shared
# secret per Bosta's documented webhook trust model -- NOT a signing key,
# there is no HMAC/signature scheme documented by Bosta.
BOSTA_WEBHOOK_SECRET=
BOSTA_BUSINESS_LOCATION_ID=

# ==============================================
# APP
# ==============================================
NODE_ENV=development
PORT=3000
APP_SESSION_SECRET=change_me_to_a_long_random_string

# Application-level distributed lock lease duration (ms).
# Must be long enough to cover the Shopify inventory check + Bosta
# Exchange creation call, short enough to self-heal after a crash.
INVENTORY_LOCK_LEASE_MS=30000

# Set to "true" only if deployed behind a trusted single load balancer
# that sets X-Forwarded-For correctly. Required for the Bosta webhook
# source-IP check (see routes/bostaWebhook.ts) to see the real client IP.
TRUST_PROXY=false
