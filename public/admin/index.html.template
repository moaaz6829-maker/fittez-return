<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>FITTEZ Refund &amp; Exchange</title>
  <meta name="shopify-api-key" content="__SHOPIFY_API_KEY__" />
  <script src="https://cdn.shopify.com/shopifycloud/app-bridge.js"></script>
  <link rel="stylesheet" href="/admin/static/styles.css" />
</head>
<body>
  <div id="app">
    <header class="topbar">
      <h1>FITTEZ Refund &amp; Exchange</h1>
      <div class="topbar-right">
        <label class="test-mode-toggle">
          <input type="checkbox" id="testModeToggle" />
          <span>Test Mode</span>
        </label>
        <span id="testModeBadge" class="badge badge-neutral" style="display:none">TEST MODE ON</span>
      </div>
    </header>

    <nav class="tabs">
      <button class="tab-btn active" data-tab="analytics">Analytics</button>
      <button class="tab-btn" data-tab="refunds">Refunds</button>
      <button class="tab-btn" data-tab="exchanges">Exchanges</button>
      <button class="tab-btn" data-tab="settings">Settings</button>
    </nav>

    <main>
      <div id="globalError" class="banner banner-error" style="display:none"></div>
      <div id="globalNotice" class="banner banner-success" style="display:none"></div>

      <section id="tab-analytics" class="tab-panel active">
        <div class="panel-header">
          <h2>Overview</h2>
          <button id="refreshAnalytics" class="btn btn-secondary">Refresh</button>
        </div>
        <div id="analyticsContainer">
          <p class="loading">Loading…</p>
        </div>
      </section>

      <section id="tab-refunds" class="tab-panel">
        <div class="panel-header">
          <h2>Refund Requests</h2>
          <button id="refreshRefunds" class="btn btn-secondary">Refresh</button>
        </div>
        <div id="refundsContainer" class="table-container">
          <p class="loading">Loading…</p>
        </div>
      </section>

      <section id="tab-exchanges" class="tab-panel">
        <div class="panel-header">
          <h2>Exchange Requests</h2>
          <button id="refreshExchanges" class="btn btn-secondary">Refresh</button>
        </div>
        <div id="exchangesContainer" class="table-container">
          <p class="loading">Loading…</p>
        </div>
      </section>

      <section id="tab-settings" class="tab-panel">
        <div class="panel-header">
          <h2>Settings</h2>
        </div>
        <div id="settingsContainer" class="card">
          <p class="loading">Loading…</p>
        </div>

        <div class="panel-header" style="margin-top:24px">
          <h2>Bosta Connection</h2>
        </div>
        <div class="card">
          <p class="muted">Checks that the configured Bosta API key is accepted. This does not create a shipment.</p>
          <button id="testBostaConnection" class="btn btn-secondary">Test Connection</button>
          <div id="bostaTestResult" class="test-result"></div>
        </div>

        <div class="panel-header" style="margin-top:24px">
          <h2>Exchange Fee by Governorate</h2>
          <button id="refreshShippingRates" class="btn btn-secondary">Refresh</button>
        </div>
        <div id="shippingRatesContainer" class="table-container">
          <p class="loading">Loading…</p>
        </div>
      </section>
    </main>
  </div>

  <!-- Modal used for the two actions that need extra input: resolving an
       ambiguous Bosta creation, and adding a note to a refund action. -->
  <div id="modalBackdrop" class="modal-backdrop" style="display:none">
    <div class="modal">
      <h3 id="modalTitle"></h3>
      <div id="modalBody"></div>
      <div class="modal-actions">
        <button id="modalCancel" class="btn btn-secondary">Cancel</button>
        <button id="modalConfirm" class="btn btn-primary">Confirm</button>
      </div>
    </div>
  </div>

  <script src="/admin/static/api.js"></script>
  <script src="/admin/static/app.js"></script>
</body>
</html>
